{
  "name": "student-org-management",
  "version": "1.0.0",
  "description": "Student Organization Management System – Phase 1: Backend Foundation",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:prod": "npx prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "test": "jest --runInBand --forceExit --detectOpenHandles",
    "test:verbose": "jest --runInBand --forceExit --detectOpenHandles --verbose",
    "posttest": "node prisma/seed.js",
    "lint": "echo \"No linter configured yet\""
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "prisma": "^6.0.0",
    "supertest": "^7.0.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "bcrypt@5.1.1": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
